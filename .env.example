# Copy to .env and fill in local values. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
LOG_LEVEL=INFO
LOG_JSON=true
# Test database; its name must end in _test because the suite drops and recreates its schema.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test
